# ==========================================================
# Dataset - Large / Generated Files
# ==========================================================

Data_Extraction/
epic-kitchens-download-scripts/

dataset/raw_videos/
dataset/clips/
dataset/frames/
dataset/annotated_frames/
dataset/detections/
dataset/scene_json/


# ==========================================================
# Keyframes
# ==========================================================

# Ignore generated keyframes by default.
dataset/keyframes/*

# Keep the final test subset keyframes in Git.
!dataset/keyframes/test/
!dataset/keyframes/test/**


# ==========================================================
# Live Cooking Session Data
# ==========================================================

# Session images and session JSON files are generated locally
# during Unity/FastAPI testing and should not be committed.
data/sessions/


# ==========================================================
# Evaluation
# ==========================================================

# KEEP evaluation files in Git.
#
# This includes:
#   evaluation/matching/P07/
#   evaluation/matching/test/
#   evaluation/results/P07/
#   evaluation/results/test/
#
# including matches.json, evaluation_summary.json,
# per_clip_summary.csv and system_comparison.csv.

!evaluation/
!evaluation/matching/
!evaluation/matching/**
!evaluation/results/
!evaluation/results/**


# ==========================================================
# Kitchen Hazard Rules
# ==========================================================

# KEEP rule definitions in Git, including:
#   rules/kitchen_rules.json
#   rules/kitchen_rules_evaluation.json

!rules/
!rules/*.json


# ==========================================================
# Pipeline Files Not Intended for Repository
# ==========================================================

# Local utility used to remove machine-specific paths.
pipeline/11_remove_local_paths.py


# ==========================================================
# Other Generated Results
# ==========================================================

# Ignore ONLY a top-level folder called "results".
#
# The leading slash is important.
# Using "results/" without the slash could also match
# evaluation/results/, which we want to keep.
/results/


